{
  "name": "margin",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning server/start.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "node --disable-warning=ExperimentalWarning server/start.mjs --preview",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build:hosted": "VITE_MARGIN_MODE=hosted tsc -b && VITE_MARGIN_MODE=hosted vite build",
    "dev:hosted:test": "node tests/hosted-fixture/start.mjs",
    "test:hosted:browser": "playwright test --config playwright.hosted.config.ts",
    "format": "prettier --write .",
    "open": "node --disable-warning=ExperimentalWarning server/open.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "driver.js": "^1.10.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.13"
  }
}
